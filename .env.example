# Scannage config. Copy to .env for a bare local run, or set the same names
# in the container environment. Never commit real values.
#
# Everything is optional: with nothing set the app keeps its data in a SQLite
# file under data/ and works on its own.

# --- store ---
# sqlite (default) or postgrest. This is a choice, not a fallback: when
# postgrest is selected and misconfigured the app refuses to start.
SCANNAGE_STORE=sqlite

# sqlite only. Defaults to data/scannage.db in the repo root.
SCANNAGE_SQLITE_PATH=

# --- addresses ---
# The public address of the app, as printed into the QR codes, for example
# https://boxes.example.com. Leave empty to derive it from each request
# (X-Forwarded-Proto and X-Forwarded-Host, then the request's own scheme and
# Host).
SCANNAGE_BASE_URL=

# --- https ---
# 1 or true makes the app serve https itself, with a self signed certificate
# it creates on first start. The port then speaks https only. Leave it off
# behind a reverse proxy that already serves https.
SCANNAGE_HTTPS=

# Extra names or addresses for the certificate, comma separated, for example
# boxes.example.com. localhost, this machine's hostname and its address on the
# local network are always included.
SCANNAGE_HTTPS_HOSTS=

# Where the certificate and its key are kept. Defaults to data/tls in the
# repo root.
SCANNAGE_TLS_DIR=

# --- postgrest store only ---
# The schema PostgREST serves for this app, pinned per request with
# Accept-Profile. The bundled deploy/*.sql files create `scannage`.
APP_SCHEMA=scannage
POSTGREST_URL=

# Signs the short-lived token the app mints for the <APP_SCHEMA>_user role.
# Must equal the secret PostgREST verifies with. JWT_SECRET is accepted as an
# alternate name. Generate with: openssl rand -base64 32
POSTGREST_JWT_SECRET=

# Direct database access, used only by the startup schema bootstrap and
# scripts/init_db.py. The user must be allowed to create schemas and roles.
# The PostgREST roles postgrest_authenticator and web_anon must already exist.
POSTGRES_URL=
POSTGRES_PORT=5432
POSTGRES_DB=apps
POSTGRES_USER=
POSTGRES_PASSWORD=
